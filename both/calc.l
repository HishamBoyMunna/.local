/*
 * ============================================================================
 * LEXICAL ANALYZER FOR YACC CALCULATOR (calc.l)
 * ============================================================================
 * HOW TO COMPILE AND RUN (WITH calc.y):
 * 
 * 1. Generate y.tab.c and y.tab.h from YACC:
 *    yacc -d calc.y
 * 
 * 2. Generate lex.yy.c from Lex:
 *    flex calc.l
 * 
 * 3. Compile both generated C files together:
 *    gcc y.tab.c lex.yy.c -o calc
 * 
 * 4. Run the executable:
 *    ./calc
 * ============================================================================
 */

%{
#include <stdio.h>
#include <stdlib.h>
#include "y.tab.h"  /* Generated by yacc -d calc.y */
extern int yylval;
%}

%%

[0-9]+          { yylval = atoi(yytext); return NUMBER; }
[ \t]+          { /* Ignore spaces and tabs */ }
\n              { return '\n'; }
.               { return yytext[0]; /* Return +, -, *, /, %, (, ) */ }

%%

int yywrap(void) {
    return 1;
}
